---
import "../styles/global.css";
import IconBook2 from "@tabler/icons/outline/book-2.svg?raw";
import IconBrandGithub from "@tabler/icons/outline/brand-github.svg?raw";
import IconBrandWhatsapp from "@tabler/icons/outline/brand-whatsapp.svg?raw";
import IconBuildingBank from "@tabler/icons/outline/building-bank.svg?raw";
import IconCalendarEvent from "@tabler/icons/outline/calendar-event.svg?raw";
import IconCheck from "@tabler/icons/outline/check.svg?raw";
import IconCircleCheck from "@tabler/icons/outline/circle-check.svg?raw";
import IconClipboardCheck from "@tabler/icons/outline/clipboard-check.svg?raw";
import IconCompass from "@tabler/icons/outline/compass.svg?raw";
import IconExternalLink from "@tabler/icons/outline/external-link.svg?raw";
import IconFileText from "@tabler/icons/outline/file-text.svg?raw";
import IconForms from "@tabler/icons/outline/forms.svg?raw";
import IconHeartHandshake from "@tabler/icons/outline/heart-handshake.svg?raw";
import IconLeaf from "@tabler/icons/outline/leaf.svg?raw";
import IconMapPin from "@tabler/icons/outline/map-pin.svg?raw";
import IconMicroscope from "@tabler/icons/outline/microscope.svg?raw";
import IconMovie from "@tabler/icons/outline/movie.svg?raw";
import IconNetwork from "@tabler/icons/outline/network.svg?raw";
import IconPresentation from "@tabler/icons/outline/presentation.svg?raw";
import IconRoute from "@tabler/icons/outline/route.svg?raw";
import IconSchool from "@tabler/icons/outline/school.svg?raw";
import IconShieldCheck from "@tabler/icons/outline/shield-check.svg?raw";
import IconTargetArrow from "@tabler/icons/outline/target-arrow.svg?raw";
import IconUsersGroup from "@tabler/icons/outline/users-group.svg?raw";
import IconX from "@tabler/icons/outline/x.svg?raw";
import { getLocalePath, guideContent, locales, type Locale } from "../data/guide";
import { getOgImagePath, ogImageSize } from "../data/guide-meta.mjs";
import GuideHero from "./GuideHero.astro";
import TranslatedGuideHero from "./TranslatedGuideHero.astro";

interface Props {
  locale: Locale;
  showDraftBanner?: boolean;
  showLanguageSwitcher?: boolean;
}

const { locale, showDraftBanner = false, showLanguageSwitcher = false } = Astro.props;
const content = guideContent[locale];
const canonicalUrl = new URL(getLocalePath(locale), "https://guide.alps.foundation").toString();
const ogImageUrl = new URL(getOgImagePath(locale), "https://guide.alps.foundation").toString();
const revealStyle = (index: number) => `--reveal-delay: ${Math.min(index * 65, 390)}ms`;
const icon = {
  book: IconBook2,
  buildingBank: IconBuildingBank,
  calendarEvent: IconCalendarEvent,
  circleCheck: IconCircleCheck,
  clipboardCheck: IconClipboardCheck,
  compass: IconCompass,
  fileText: IconFileText,
  forms: IconForms,
  heartHandshake: IconHeartHandshake,
  leaf: IconLeaf,
  mapPin: IconMapPin,
  microscope: IconMicroscope,
  movie: IconMovie,
  network: IconNetwork,
  presentation: IconPresentation,
  route: IconRoute,
  school: IconSchool,
  shieldCheck: IconShieldCheck,
  targetArrow: IconTargetArrow,
  usersGroup: IconUsersGroup,
  whatsapp: IconBrandWhatsapp,
};
---

<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={content.meta.description} />
    <meta name="generator" content={Astro.generator} />
    <title>{content.meta.title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((availableLocale) => (
      <link rel="alternate" hreflang={availableLocale} href={new URL(getLocalePath(availableLocale), "https://guide.alps.foundation").toString()} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://guide.alps.foundation/" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="ALPS Foundation" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta property="og:image:alt" content={content.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.title} />
    <meta name="twitter:description" content={content.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    {showDraftBanner && (
      <p class="draft-translation-banner">
        {content.draftBanner}
      </p>
    )}

    <main class="guide-page mx-auto min-h-screen w-full max-w-[1720px] px-5 pt-5 pb-28 text-ink sm:px-8 lg:px-12">
      {locale === "en" ? (
        <GuideHero content={content} locale={locale} showLanguageSwitcher={showLanguageSwitcher} />
      ) : (
        <TranslatedGuideHero content={content} locale={locale} showLanguageSwitcher={showLanguageSwitcher} />
      )}

      <section class="grid gap-10 py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" data-reveal>
        <aside class="lg:sticky lg:top-6 lg:self-start">
          <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
            <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconCompass} />
            {content.why.label}
          </p>
        </aside>
        <div class="max-w-5xl space-y-8">
          <p class="guide-kicker-title bg-gradient-to-r from-ink via-olive-900 to-olive-700 bg-clip-text font-semibold text-transparent">
            {content.why.headline}
          </p>
          <div class="grid gap-8 border-y border-rule py-8 text-lg leading-relaxed text-ink-soft md:grid-cols-2">
            {content.why.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="grid gap-10 border-t border-ink py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" data-reveal>
        <aside class="lg:sticky lg:top-6 lg:self-start">
          <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
            <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconMapPin} />
            {content.origin.label}
          </p>
          <h2 class="guide-section-title mt-4 bg-gradient-to-br from-ink to-olive-700 bg-clip-text font-black text-transparent">{content.origin.title}</h2>
        </aside>
        <div class="max-w-4xl rounded-sm border-l-4 border-olive-700 bg-olive-100/70 p-6 text-lg leading-relaxed text-ink-soft" data-reveal>
          {content.origin.paragraphs.map((paragraph, index) => (
            <p class:list={[index > 0 && "mt-5", index === content.origin.paragraphs.length - 1 && "italic"]}>{paragraph}</p>
          ))}
        </div>
      </section>

      <section class="grid gap-10 border-t border-ink py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" data-reveal>
        <aside class="lg:sticky lg:top-6 lg:self-start">
          <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
            <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconSchool} />
            {content.principles.label}
          </p>
          <h2 class="guide-section-title mt-4 bg-gradient-to-br from-ink to-olive-700 bg-clip-text font-black text-transparent">{content.principles.title}</h2>
        </aside>
        <div class="overflow-hidden rounded-sm border border-rule bg-paper/70">
          <table class="block w-full text-left md:table md:table-fixed">
            <colgroup class="hidden md:table-column-group">
              <col class="md:w-[35%]" />
              <col class="md:w-[65%]" />
            </colgroup>
            <thead class="hidden bg-olive-100/80 text-sm font-bold uppercase text-olive-950 md:table-header-group">
              <tr>
                <th scope="col" class="border-b border-rule p-4 font-bold">{content.principles.principleHeading}</th>
                <th scope="col" class="border-b border-l border-rule p-4 font-bold">{content.principles.campusHeading}</th>
              </tr>
            </thead>
            <tbody class="block md:table-row-group">
              {content.principles.items.map(({ icon: iconName, principle, campus }, index) => (
                <tr class="block border-b border-rule last:border-b-0 md:table-row md:align-top" data-reveal style={revealStyle(index)}>
                  <th scope="row" class="block p-4 text-left font-semibold text-ink md:table-cell">
                    <span class="flex items-center gap-3">
                      <span class="guide-icon h-5 w-5 shrink-0 text-olive-700" aria-hidden="true" set:html={icon[iconName]} />
                      <span>{principle}</span>
                    </span>
                  </th>
                  <td class="block px-4 pb-4 leading-relaxed text-ink-soft md:table-cell md:border-l md:border-rule md:p-4">{campus}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <div class="guide-workflow" data-guide-workflow>
        <nav class="scrollspy-nav" aria-label="Guide parts" data-scrollspy-nav>
          <div class="scrollspy-nav__track" aria-hidden="true">
            <span class="scrollspy-nav__progress" data-scrollspy-progress></span>
          </div>
          <ol class="scrollspy-nav__list">
            {content.guideParts.map((part) => (
              <li class="scrollspy-nav__item">
                <a class="scrollspy-link" href={`#${part.id}`} data-scrollspy-link data-scrollspy-id={part.id} aria-label={`${part.partLabel}: ${part.label}`}>
                  <span class="guide-icon scrollspy-link__icon" aria-hidden="true" set:html={icon[part.icon]} />
                  <span class="scrollspy-link__marker" aria-hidden="true">
                    <span class="scrollspy-link__number">{part.number}</span>
                    <span class="guide-icon scrollspy-link__check" set:html={IconCheck} />
                  </span>
                  <span class="scrollspy-link__copy">
                    <span class="scrollspy-link__part">{part.partLabel}</span>
                    <span class="scrollspy-link__title">{part.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <section class="grid scroll-mt-6 gap-10 border-t border-ink py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" id="register" data-guide-part data-scrollspy-label={content.guideParts[0].label} data-reveal>
          <aside class="lg:sticky lg:top-6 lg:self-start">
            <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
              <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconClipboardCheck} />
              {content.guideParts[0].partLabel}
            </p>
            <h2 class="guide-part-title mt-4 bg-gradient-to-br from-ink via-olive-900 to-olive-700 bg-clip-text font-black text-transparent">{content.register.title}</h2>
            <p class="mt-6 text-base leading-relaxed text-ink-soft">{content.register.intro}</p>
          </aside>
          <div class="space-y-10">
            <ol class="border-y border-rule">
              {content.register.steps.map((step, index) => (
                <li class="grid gap-5 border-b border-rule py-7 last:border-b-0 md:grid-cols-[5rem_1fr]" data-reveal style={revealStyle(index)}>
                  <p class="bg-gradient-to-br from-olive-500 to-olive-900 bg-clip-text text-5xl font-black leading-none text-transparent">{String(index + 1).padStart(2, "0")}</p>
                  <div>
                    <h3 class="flex min-w-0 items-center gap-3 text-2xl font-bold">
                      <span class="guide-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-olive-800/20 bg-olive-100 text-olive-800" aria-hidden="true" set:html={icon[step.icon]} />
                      <span class="guide-text-wrap min-w-0">{step.title}</span>
                    </h3>
                    <p class="mt-3 max-w-3xl text-lg leading-relaxed text-ink-soft">{step.body}</p>
                  </div>
                </li>
              ))}
            </ol>
            <aside class="rounded-sm border border-olive-800/40 bg-gradient-to-br from-olive-100 to-paper p-6" data-reveal>
              <h3 class="flex items-center gap-3 text-xl font-bold">
                <span class="guide-icon h-6 w-6 shrink-0 text-olive-700" aria-hidden="true" set:html={IconSchool} />
                {content.register.tipTitle}
              </h3>
              {content.register.tipParagraphs.map((paragraph) => <p class="mt-4 text-lg leading-relaxed text-ink-soft">{paragraph}</p>)}
            </aside>
          </div>
        </section>

        <section class="grid scroll-mt-6 gap-10 border-t border-ink py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" id="mission" data-guide-part data-scrollspy-label={content.guideParts[1].label} data-reveal>
          <aside class="lg:sticky lg:top-6 lg:self-start">
            <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
              <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconTargetArrow} />
              {content.guideParts[1].partLabel}
            </p>
            <h2 class="guide-part-title mt-4 bg-gradient-to-br from-ink via-olive-900 to-olive-700 bg-clip-text font-black text-transparent">{content.mission.title}</h2>
            <p class="mt-6 text-base leading-relaxed text-ink-soft">{content.mission.intro}</p>
          </aside>
          <div class="space-y-16">
            <section data-reveal>
              <h3 class="flex items-center gap-3 text-3xl font-black">
                <span class="guide-icon h-7 w-7 shrink-0 text-olive-700" aria-hidden="true" set:html={IconTargetArrow} />
                <span class="guide-text-wrap min-w-0">{content.mission.missionTitle}</span>
              </h3>
              <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-soft">{content.mission.missionIntro}</p>
              <div class="mt-8 grid gap-8 md:grid-cols-2">
                <div>
                  <p class="border-b border-olive-700 pb-3 text-sm font-bold uppercase text-olive-700">{content.mission.isLabel}</p>
                  <ul class="divide-y divide-rule">
                    {content.mission.isItems.map((item, index) => (
                      <li class="flex gap-3 py-4 text-lg leading-relaxed text-ink-soft" data-reveal style={revealStyle(index)}>
                        <span class="guide-icon list-icon h-5 w-5 text-olive-700" aria-hidden="true" set:html={IconCheck} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="border-b border-[#7a1f1f] pb-3 text-sm font-bold uppercase text-[#7a1f1f]">{content.mission.notLabel}</p>
                  <ul class="divide-y divide-rule">
                    {content.mission.notItems.map((item, index) => (
                      <li class="flex gap-3 py-4 text-lg leading-relaxed text-ink-soft" data-reveal style={revealStyle(index)}>
                        <span class="guide-icon list-icon h-5 w-5 text-[#7a1f1f]" aria-hidden="true" set:html={IconX} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>

            <section class="grid gap-10 md:grid-cols-2" data-reveal>
              <div>
                <h3 class="flex items-center gap-3 text-3xl font-black">
                  <span class="guide-icon h-7 w-7 shrink-0 text-olive-700" aria-hidden="true" set:html={IconShieldCheck} />
                  <span class="guide-text-wrap min-w-0">{content.mission.ethicsTitle}</span>
                </h3>
                <ul class="mt-6 divide-y divide-rule border-y border-rule">
                  {content.mission.ethics.map(({ icon: iconName, text }, index) => (
                    <li class="flex gap-3 py-4 text-base leading-relaxed text-ink-soft" data-reveal style={revealStyle(index)}>
                      <span class="guide-icon list-icon h-5 w-5 text-olive-700" aria-hidden="true" set:html={icon[iconName]} />
                      <span>{text}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="flex items-center gap-3 text-3xl font-black">
                  <span class="guide-icon h-7 w-7 shrink-0 text-olive-700" aria-hidden="true" set:html={IconPresentation} />
                  <span class="guide-text-wrap min-w-0">{content.mission.formatsTitle}</span>
                </h3>
                <ul class="mt-6 divide-y divide-rule border-y border-rule">
                  {content.mission.formats.map(({ icon: iconName, text }, index) => (
                    <li class="flex gap-3 py-4 text-base leading-relaxed text-ink-soft" data-reveal style={revealStyle(index)}>
                      <span class="guide-icon list-icon h-5 w-5 text-olive-700" aria-hidden="true" set:html={icon[iconName]} />
                      <span>{text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>

            <aside class="rounded-sm border border-olive-800/40 bg-gradient-to-br from-olive-100 to-paper p-6" data-reveal>
              <h3 class="flex items-center gap-3 text-xl font-bold">
                <span class="guide-icon h-6 w-6 shrink-0 text-olive-700" aria-hidden="true" set:html={IconLeaf} />
                {content.mission.caseTitle}
              </h3>
              <p class="mt-4 text-lg leading-relaxed text-ink-soft">{content.mission.caseIntro}</p>
              <ul class="mt-5 divide-y divide-rule border-y border-rule">
                {content.mission.palaPillars.map((item, index) => (
                  <li class="flex gap-3 py-3 text-base leading-relaxed text-ink-soft" data-reveal style={revealStyle(index)}>
                    <span class="guide-icon list-icon h-5 w-5 text-olive-700" aria-hidden="true" set:html={IconCircleCheck} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </aside>
          </div>
        </section>

        <section class="grid scroll-mt-6 gap-10 border-t border-ink py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" id="swiss-model" data-guide-part data-scrollspy-label={content.guideParts[2].label} data-reveal>
          <aside class="lg:sticky lg:top-6 lg:self-start">
            <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
              <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconNetwork} />
              {content.guideParts[2].partLabel}
            </p>
            <h2 class="guide-part-title mt-4 bg-gradient-to-br from-ink via-olive-900 to-olive-700 bg-clip-text font-black text-transparent">{content.swissModel.title}</h2>
          </aside>
          <div class="space-y-12">
            <p class="max-w-4xl text-2xl font-semibold leading-tight text-ink" data-reveal>{content.swissModel.intro}</p>

            <aside class="rounded-sm border border-olive-800/40 bg-gradient-to-br from-olive-100 to-paper p-6" data-reveal>
              <h3 class="flex items-center gap-3 text-xl font-bold">
                <span class="guide-icon h-6 w-6 shrink-0 text-olive-700" aria-hidden="true" set:html={IconTargetArrow} />
                <span>{content.swissModel.namingTitle}</span>
              </h3>
              <p class="mt-4 text-lg leading-relaxed text-ink-soft">{content.swissModel.namingIntro}</p>
              <ul class="mt-5 divide-y divide-rule border-y border-rule">
                {content.swissModel.namingAdvice.map((item, index) => (
                  <li class="flex gap-3 py-3 text-base leading-relaxed text-ink-soft" data-reveal style={revealStyle(index)}>
                    <span class="guide-icon list-icon h-5 w-5 text-olive-700" aria-hidden="true" set:html={IconCircleCheck} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </aside>

            <div class="grid gap-6 md:grid-cols-2">
              {content.swissModel.figures.map((figure, index) => (
                <figure class="overflow-hidden rounded-sm border border-rule bg-paper-alt" data-reveal style={index > 0 ? "--reveal-delay: 120ms" : undefined}>
                  <img class="aspect-video w-full bg-white object-cover" src={figure.src} alt={figure.alt} loading="lazy" decoding="async" />
                  <figcaption class="border-t border-rule p-4 text-sm italic leading-relaxed text-ink-soft">{figure.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>

        <section class="grid scroll-mt-6 gap-10 border-t border-ink py-20 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:py-28" id="kickstart" data-guide-part data-scrollspy-label={content.guideParts[3].label} data-reveal>
          <aside class="lg:sticky lg:top-6 lg:self-start">
            <p class="flex items-center gap-4 text-2xl font-semibold uppercase text-ink-soft">
              <span class="guide-icon h-8 w-8 shrink-0 text-olive-700" aria-hidden="true" set:html={IconRoute} />
              {content.guideParts[3].partLabel}
            </p>
            <h2 class="guide-part-title mt-4 bg-gradient-to-br from-ink via-olive-900 to-olive-700 bg-clip-text font-black text-transparent">{content.kickstart.title}</h2>
            <p class="mt-6 text-base leading-relaxed text-ink-soft">{content.kickstart.intro}</p>
          </aside>
          <div class="space-y-16">
            {content.kickstart.actions.map((action) => (
              <section class="space-y-5 border-y border-rule py-8" data-reveal>
                <h3 class="flex items-center gap-3 text-2xl font-bold">
                  <span class="guide-icon h-6 w-6 shrink-0 text-olive-700" aria-hidden="true" set:html={icon[action.icon]} />
                  <span class="guide-text-wrap min-w-0">{action.title}</span>
                </h3>
                {action.paragraphs.map((paragraph) => <p class="text-lg leading-relaxed text-ink-soft">{paragraph}</p>)}
              </section>
            ))}

            <section data-reveal>
              <h3 class="flex items-center gap-3 text-3xl font-black">
                <span class="guide-icon h-7 w-7 shrink-0 text-olive-700" aria-hidden="true" set:html={IconNetwork} />
                <span class="guide-text-wrap min-w-0">{content.kickstart.networkTitle}</span>
              </h3>
              {content.kickstart.networkParagraphs.map((paragraph) => <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-soft">{paragraph}</p>)}
              <ul class="mt-8 divide-y divide-rule border-y border-rule">
                {content.kickstart.resources.map(({ title, displayUrl, href }, index) => (
                  <li data-reveal style={revealStyle(index)}>
                    <a class="resource-link" href={href} target="_blank" rel="noreferrer">
                      <span class="resource-link__title">{title}</span>
                      <span class="resource-link__badge">
                        <span class="resource-link__url">{displayUrl}</span>
                        <span class="guide-icon resource-link__icon" aria-hidden="true" set:html={IconExternalLink} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>

            <section data-reveal>
              <h3 class="flex items-center gap-3 text-3xl font-black">
                <span class="guide-icon h-7 w-7 shrink-0 text-olive-700" aria-hidden="true" set:html={IconCalendarEvent} />
                <span class="guide-text-wrap min-w-0">{content.kickstart.timelineTitle}</span>
              </h3>
              <div class="mt-6 overflow-hidden rounded-sm border border-rule">
                {content.kickstart.timeline.map(({ year, text }, index) => (
                  <div class="grid gap-4 border-b border-rule last:border-b-0 md:grid-cols-[9rem_1fr]" data-reveal style={revealStyle(index)}>
                    <p class="bg-olive-100/70 p-4 font-bold text-olive-950">{year}</p>
                    <p class="flex gap-3 p-4 leading-relaxed text-ink-soft">
                      <span class="guide-icon list-icon h-5 w-5 text-olive-700" aria-hidden="true" set:html={IconCalendarEvent} />
                      <span>{text}</span>
                    </p>
                  </div>
                ))}
              </div>
            </section>

            <aside class="rounded-sm border border-olive-900/45 bg-gradient-to-br from-olive-950 via-olive-900 to-ink p-6 text-paper" data-reveal>
              <h3 class="flex items-center gap-3 text-2xl font-black">
                <span class="guide-icon h-7 w-7 shrink-0 text-olive-200" aria-hidden="true" set:html={IconLeaf} />
                {content.kickstart.rememberTitle}
              </h3>
              <ul class="mt-5 divide-y divide-paper/25 border-y border-paper/25">
                {content.kickstart.remember.map((item, index) => (
                  <li class="flex gap-3 py-3 leading-relaxed text-paper/90" data-reveal style={revealStyle(index)}>
                    <span class="guide-icon list-icon h-5 w-5 text-olive-200" aria-hidden="true" set:html={IconCircleCheck} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </aside>
          </div>
        </section>
      </div>

      <footer class="grid gap-10 border-t border-ink py-10 text-sm text-ink-soft lg:grid-cols-[0.68fr_1.32fr] lg:gap-16" data-reveal>
        <div class="space-y-5">
          <a class="block w-fit" href="https://alps.foundation" aria-label="ALPS Foundation">
            <span class="alps-logo-mask alps-logo-mask--footer" aria-hidden="true"></span>
          </a>
          <p class="font-semibold uppercase text-ink">{content.footer.version}</p>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          <div class="space-y-4">
            <p class="font-semibold text-ink">{content.meta.title}</p>
            <p>{content.meta.description}</p>
          </div>
          <div class="flex flex-col gap-5 md:flex-row md:items-start">
            <p>
              {content.footer.builtWith} <a class="text-ink underline decoration-olive-700/40 underline-offset-4 transition hover:text-olive-700" href="https://www.indiantypefoundry.com/" target="_blank" rel="noreferrer">Indian Type Foundry</a>, <a class="text-ink underline decoration-olive-700/40 underline-offset-4 transition hover:text-olive-700" href="https://tabler.io/icons" target="_blank" rel="noreferrer">Tabler Icons</a>, and <a class="text-ink underline decoration-olive-700/40 underline-offset-4 transition hover:text-olive-700" href="https://astro.build" target="_blank" rel="noreferrer">Astro.build</a>.
            </p>
            <a class="flex items-center gap-2 border-t border-rule pt-5 text-ink transition hover:text-olive-700 md:border-t-0 md:border-l md:pt-0 md:pl-5" href="https://github.com/alpsfoundation/guide.alps.foundation" target="_blank" rel="noreferrer">
              <span class="guide-icon h-5 w-5 shrink-0" aria-hidden="true" set:html={IconBrandGithub} />
              <span>{content.footer.sourceLabel}</span>
            </a>
          </div>
        </div>
        {content.footer.translationReviewer && (
          <p class="col-span-full border-t border-rule pt-6 text-ink-soft">{content.footer.translationReviewer}</p>
        )}
      </footer>
    </main>
    <script>
      const revealElements = document.querySelectorAll("[data-reveal]");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => element.classList.add("is-visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.12,
          },
        );

        revealElements.forEach((element) => revealObserver.observe(element));
      }

      const guideSections = Array.from(document.querySelectorAll<HTMLElement>("[data-guide-part]"));
      const guideLinks = Array.from(document.querySelectorAll<HTMLElement>("[data-scrollspy-link]"));
      const guideWorkflow = document.querySelector<HTMLElement>("[data-guide-workflow]");
      const scrollspyNav = document.querySelector<HTMLElement>("[data-scrollspy-nav]");
      const scrollspyProgress = document.querySelector<HTMLElement>("[data-scrollspy-progress]");
      let scrollspyFrame = 0;
      let scrollspyClickLockUntil = 0;
      const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

      const setGuideStatus = (activeIndex: number, progressPercent: number, isComplete = false) => {
        guideLinks.forEach((link, index) => {
          const status = isComplete && index <= activeIndex ? "complete" : index < activeIndex ? "complete" : index === activeIndex ? "current" : "upcoming";
          link.setAttribute("data-status", status);

          if (!isComplete && index === activeIndex) {
            link.setAttribute("aria-current", "step");
          } else {
            link.removeAttribute("aria-current");
          }
        });

        if (scrollspyProgress) {
          scrollspyProgress.style.setProperty("--scrollspy-progress", `${clamp(progressPercent, 0, 100)}%`);
        }
      };

      const setActiveGuidePart = () => {
        scrollspyFrame = 0;
        if (!guideSections.length || !guideLinks.length) return;
        if (performance.now() < scrollspyClickLockUntil) return;

        const anchorLine = window.innerHeight * 0.42;
        const anchorDocumentY = window.scrollY + anchorLine;
        let activeIndex = 0;
        const firstSectionRect = guideSections[0].getBoundingClientRect();

        if (scrollspyNav) {
          scrollspyNav.classList.toggle("is-sticky", firstSectionRect.top <= window.innerHeight);
        }

        guideSections.forEach((section, index) => {
          const rect = section.getBoundingClientRect();
          if (rect.top <= anchorLine) {
            activeIndex = index;
          }
        });

        const activeSection = guideSections[activeIndex];
        const sectionStart = activeSection.offsetTop;
        const sectionEnd = sectionStart + activeSection.offsetHeight;
        const sectionProgress = clamp((anchorDocumentY - sectionStart) / Math.max(sectionEnd - sectionStart, 1), 0, 1);
        const finalSection = guideSections[guideSections.length - 1];
        const finalSectionEnd = finalSection.offsetTop + finalSection.offsetHeight;
        const isComplete = anchorDocumentY >= finalSectionEnd || (guideWorkflow ? guideWorkflow.getBoundingClientRect().bottom <= window.innerHeight : false);
        const progressPercent = isComplete ? 100 : ((activeIndex + sectionProgress) / guideSections.length) * 100;

        setGuideStatus(activeIndex, progressPercent, isComplete);
      };

      const requestScrollspyUpdate = () => {
        if (scrollspyFrame) return;
        scrollspyFrame = window.requestAnimationFrame(setActiveGuidePart);
      };

      setActiveGuidePart();
      guideLinks.forEach((link, index) => {
        link.addEventListener("click", () => {
          scrollspyClickLockUntil = performance.now() + 900;
          setGuideStatus(index, (index / guideSections.length) * 100);
        });
      });
      window.addEventListener("scroll", requestScrollspyUpdate, { passive: true });
      window.addEventListener("resize", requestScrollspyUpdate);
    </script>
  </body>
</html>
