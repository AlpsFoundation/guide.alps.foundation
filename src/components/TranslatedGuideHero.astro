---
import type { GuideContent, Locale } from "../data/guide";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  content: Pick<GuideContent, "hero" | "languageSwitcherLabel">;
  locale: Locale;
  showLanguageSwitcher?: boolean;
}

const { content, locale, showLanguageSwitcher = false } = Astro.props;
---

<header class="relative grid min-h-[90vh] overflow-hidden rounded-sm border border-white/20 bg-[url('/hero.jpg')] bg-cover bg-center p-5 text-white shadow-[0_1.5rem_4rem_rgb(20_20_15_/_0.22)] lg:grid-cols-[0.68fr_1.32fr] lg:gap-16 lg:p-8" data-reveal>
  <div class="absolute inset-0 bg-gradient-to-br from-ink/85 via-olive-950/58 to-ink/20" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-white/5" aria-hidden="true"></div>

  {showLanguageSwitcher && (
    <LanguageSwitcher currentLocale={locale} label={content.languageSwitcherLabel} />
  )}

  <a
    class="absolute right-4 bottom-4 text-xs font-semibold text-white/40 transition hover:text-white sm:right-5 sm:bottom-5"
    href="https://www.instagram.com/joltherixo_art/"
    target="_blank"
    rel="noreferrer"
    aria-label="Artwork credit: @joltherixo_art on Instagram"
  >
    @joltherixo_art
  </a>

  <div class="relative z-10 flex flex-col justify-between gap-12">
    <a class="sticky top-8 z-10 w-fit" href="https://alps.foundation" aria-label="ALPS Foundation">
      <span class="alps-logo-mask alps-logo-mask--header alps-logo-mask--hero-image" aria-hidden="true"></span>
    </a>
    <p class="max-w-sm border-l-2 border-white/60 pl-5 text-base leading-relaxed text-white/85">
      {content.hero.summary}
    </p>
  </div>

  <section class="relative z-10 flex flex-col justify-end pt-20">
    <h1 class="guide-hero-title guide-translated-hero-title max-w-6xl bg-gradient-to-br from-white via-white/90 to-olive-100 bg-clip-text font-black text-transparent drop-shadow-[0_0.2rem_1.4rem_rgb(20_20_15_/_0.45)]">
      {content.hero.title}
    </h1>
  </section>
</header>
